# Browser-public values only (never put service_role or TELEGRAM_BOT_TOKEN here).
# Shared project: kyiv-air-raid-alerts (ref maqdxmetyzpyupivyecz).
# Tables live in Postgres schema `jam` — expose it in Dashboard → API settings.
#
# Local:
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
# Hosted:
#   VITE_SUPABASE_URL=https://maqdxmetyzpyupivyecz.supabase.co
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Telegram Login Widget bot username (without @). Create via @BotFather.
VITE_TELEGRAM_BOT_USERNAME=YourJamMatchBot

# Show email/password + magic-link UI (local seed accounts only).
# Leave unset / false for production — Telegram is the main path.
# VITE_ENABLE_EMAIL_LOGIN=true
